# Cloudflare Pages response headers.
# The repository root is deployed as-is, so keep the files that are not pages
# out of search results.
/README.md
  X-Robots-Tag: noindex
/SECURITY.md
  X-Robots-Tag: noindex
/tests/*
  X-Robots-Tag: noindex
/brief/*
  X-Robots-Tag: noindex
/lib/*
  X-Robots-Tag: noindex
/functions/*
  X-Robots-Tag: noindex
# Baseline security headers for every response. Cloudflare Pages joins
# repeated headers with a comma, so the rules below must not set these again.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
# The audit page renders text from other websites, so it gets a strict policy:
# only this site's scripts (plus the hashed inline "js" class line), its own font
# and the optional Cloudflare Web Analytics beacon.
/website-audit
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
# security.txt (RFC 9116) must be plain text at exactly /.well-known/security.txt.
# (nosniff comes from the /* rule above.)
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
